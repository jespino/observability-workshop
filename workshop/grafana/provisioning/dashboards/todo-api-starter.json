{
  "uid": "workshop-starter",
  "title": "todo-api \u2014 starter",
  "tags": [
    "workshop"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "list",
        "label": "list",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "query": "label_values(todos_created_total, list)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Read me first",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "This dashboard is deliberately almost empty.\n\nThe panel below is the only one provisioned for you: it watches the **telemetry pipeline itself**, which is the thing you will wish you had when data stops arriving (Module 4.2).\n\nYou build the RED panels and the business panels yourself in **Module 5.5**, and add a logs panel in **Module 6.4**. Copy this dashboard rather than editing it if you want to keep the original."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Collector: telemetry in vs. telemetry out",
      "description": "If accepted keeps climbing while sent goes flat, the pipeline has stopped delivering and your application will not tell you.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(otelcol_receiver_accepted_spans_total[1m])",
          "legendFormat": "spans accepted"
        },
        {
          "refId": "B",
          "expr": "rate(otelcol_exporter_sent_spans_total[1m])",
          "legendFormat": "spans sent \u2014 {{exporter}}"
        },
        {
          "refId": "C",
          "expr": "rate(otelcol_receiver_accepted_log_records_total[1m])",
          "legendFormat": "logs accepted"
        },
        {
          "refId": "D",
          "expr": "rate(otelcol_exporter_sent_log_records_total[1m])",
          "legendFormat": "logs sent \u2014 {{exporter}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Collector: exporter queue size",
      "description": "A queue that only grows means the backend is not keeping up, or is gone.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "otelcol_exporter_queue_size",
          "legendFormat": "{{exporter}}"
        },
        {
          "refId": "B",
          "expr": "otelcol_exporter_queue_capacity",
          "legendFormat": "{{exporter}} capacity"
        }
      ]
    }
  ]
}
