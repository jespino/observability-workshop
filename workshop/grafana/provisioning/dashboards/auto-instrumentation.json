{
  "uid": "workshop-auto",
  "title": "Auto-Instrumentation",
  "tags": [
    "workshop"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "Everything on this dashboard comes from **auto-instrumentation**: the OpenTelemetry SDK and its instrumentation libraries, with no change to the application's code. HTTP server and client metrics, the traces of every request, and the application's existing log lines.\n\nEmpty HTTP panels are information too: not every SDK records HTTP metrics."
      },
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "HTTP server — todo-api",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests per second",
      "description": "Every HTTP request todo-api served, by method and status code.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=\"todo-api\"}[1m])) by (http_method, http_status_code)",
          "legendFormat": "{{http_method}} {{http_status_code}}",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"todo-api\"}[1m])) by (http_request_method, http_response_status_code)",
          "legendFormat": "{{http_request_method}} {{http_response_status_code}}",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "timeseries",
      "title": "Errors per second (5xx)",
      "description": "Requests that ended in a server error.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=\"todo-api\",http_status_code=~\"5..\"}[1m]))",
          "legendFormat": "5xx",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"todo-api\",http_response_status_code=~\"5..\"}[1m]))",
          "legendFormat": "5xx",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 5
      }
    },
    {
      "type": "timeseries",
      "title": "Request duration",
      "description": "p50 and p95 of the time todo-api took to answer.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_duration_milliseconds_bucket{service_name=\"todo-api\"}[1m])) by (le))",
          "legendFormat": "p95",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum(rate(http_server_duration_milliseconds_bucket{service_name=\"todo-api\"}[1m])) by (le))",
          "legendFormat": "p50",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{service_name=\"todo-api\"}[1m])) by (le)) * 1000",
          "legendFormat": "p95",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.50, sum(rate(http_server_request_duration_seconds_bucket{service_name=\"todo-api\"}[1m])) by (le)) * 1000",
          "legendFormat": "p50",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        }
      ],
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 5
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Outgoing calls — todo-api to notify-service",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Calls per second",
      "description": "HTTP requests todo-api made to other services.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_client_duration_milliseconds_count{service_name=\"todo-api\"}[1m])) by (net_peer_name, http_status_code)",
          "legendFormat": "{{net_peer_name}} {{http_status_code}}",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_client_request_duration_seconds_count{service_name=\"todo-api\"}[1m])) by (server_address, http_response_status_code)",
          "legendFormat": "{{server_address}} {{http_response_status_code}}",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        }
      ],
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "Call duration p95",
      "description": "How long todo-api waited for the other service to answer.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_client_duration_milliseconds_bucket{service_name=\"todo-api\"}[1m])) by (le, net_peer_name))",
          "legendFormat": "{{net_peer_name}}",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(http_client_request_duration_seconds_bucket{service_name=\"todo-api\"}[1m])) by (le, server_address)) * 1000",
          "legendFormat": "{{server_address}}",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        }
      ],
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Logs and traces",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "Logs — todo-api",
      "description": "The application's existing log lines, as the SDK exports them.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service.name:todo-api",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "id": 10,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 23
      }
    },
    {
      "type": "table",
      "title": "Recent traces — todo-api",
      "description": "The latest traces in VictoriaTraces. Click a trace ID to open its waterfall.",
      "datasource": {
        "type": "jaeger",
        "uid": "victoriatraces-jaeger"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "jaeger",
            "uid": "victoriatraces-jaeger"
          },
          "queryType": "search",
          "service": "todo-api",
          "limit": 20
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "id": 11,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 23
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Telemetry pipeline — the Collector",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Telemetry in vs. telemetry out",
      "description": "If accepted keeps climbing while sent goes flat, the pipeline has stopped delivering and your application will not tell you.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_receiver_accepted_spans_total[1m]))",
          "legendFormat": "spans accepted",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(otelcol_exporter_sent_spans_total[1m])) by (exporter)",
          "legendFormat": "spans sent — {{exporter}}",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "C",
          "expr": "sum(rate(otelcol_receiver_accepted_metric_points_total[1m]))",
          "legendFormat": "metric points accepted",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "D",
          "expr": "sum(rate(otelcol_receiver_accepted_log_records_total[1m]))",
          "legendFormat": "logs accepted",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "E",
          "expr": "sum(rate(otelcol_exporter_sent_log_records_total[1m])) by (exporter)",
          "legendFormat": "logs sent — {{exporter}}",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        }
      ],
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      }
    },
    {
      "type": "timeseries",
      "title": "Exporter queue size",
      "description": "A queue that only grows means the backend is not keeping up, or is gone.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "otelcol_exporter_queue_size",
          "legendFormat": "{{exporter}}",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "otelcol_exporter_queue_capacity",
          "legendFormat": "{{exporter}} capacity",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        }
      ],
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      }
    }
  ],
  "annotations": {
