# notify-service (Python) — the downstream service you do NOT instrument.
#
# Passed to the container with --env-file. It is already here, filled in,
# because this service is not the exercise: it is pre-instrumented so that a
# trace from your API has somewhere to go. Read it anyway — in Module 3.1 you
# write a file of exactly this shape for your own API.

OTEL_SERVICE_NAME=notify-service
OTEL_RESOURCE_ATTRIBUTES=service.version=1.0.0,deployment.environment=workshop
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRIC_EXPORT_INTERVAL=10000

# Must be <= OTEL_METRIC_EXPORT_INTERVAL. The default is 30000, and the JS SDK
# refuses to initialise at all when the timeout exceeds the interval — it logs
# one line and then emits nothing, which is a memorable way to lose an hour.
OTEL_METRIC_EXPORT_TIMEOUT=5000
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
OTEL_PYTHON_LOG_CORRELATION=true

# Where pip installed the packages. The image is a stock python:3.12-slim, so
# they went into the bind-mounted source directory rather than into the image.
PYTHONUSERBASE=/app/.pylibs
PATH=/app/.pylibs/bin:/usr/local/bin:/usr/bin:/bin
PORT=8083
