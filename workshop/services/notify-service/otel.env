# notify-service — the downstream service you do NOT instrument.
#
# Loaded by docker-compose.yml (env_file). It is already here, filled in,
# because this service is not the exercise: it is pre-instrumented so that a
# trace from your API has somewhere to go. Read it anyway — in Module 4.1 you
# write a file of exactly this shape for your own API.

OTEL_SERVICE_NAME=notify-service
OTEL_RESOURCE_ATTRIBUTES=service.version=1.0.0,deployment.environment=workshop
# The Collector's Compose service name. Your API's .env (Module 4.1) says the same.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRIC_EXPORT_INTERVAL=10000

# Must be <= OTEL_METRIC_EXPORT_INTERVAL. The default is 30000: older JS SDKs
# refused to initialise at all when the timeout exceeded the interval, and
# current ones quietly shorten it. Setting it explicitly avoids both.
OTEL_METRIC_EXPORT_TIMEOUT=5000
OTEL_PYTHON_LOG_AUTO_INSTRUMENTATION=true
OTEL_PYTHON_LOG_CORRELATION=true

PORT=8083
